# Imagen de desarrollo para Tilt: corre el dev server de Next con hot reload sobre los
# archivos que Tilt sincroniza. El Dockerfile de produccion es `ui/Dockerfile`.
FROM node:22-alpine

WORKDIR /app

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui/ .

ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000
CMD ["npm", "run", "dev"]
