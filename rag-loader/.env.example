DATABASE_URL=postgresql+psycopg://cartia:cartia@localhost:5432/cartia
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Directorio local con los documentos a ingestar.
DOCUMENTS_DIR=./documents

# Chunking. Los valores estan calibrados para normativa argentina: un articulo tipico
# entra completo en 1800 caracteres, y el overlap preserva contexto entre incisos.
MAX_CHUNK_CHARS=1800
MIN_CHUNK_CHARS=250
CHUNK_OVERLAP_CHARS=200

EMBED_BATCH_SIZE=32
INTERNAL_TOKEN=change-me-shared-with-backend
LOG_LEVEL=INFO

# Scraper de normas (InfoLEG / datos.jus.gob.ar). Los defaults alcanzan para empezar.
# SCRAPER_CATALOG_URL=   # URL directa del zip del catalogo; vacio = descubrir del portal
# SCRAPER_DELAY_SECONDS=0.8
# SCRAPER_TIMEOUT_SECONDS=60
# SCRAPER_USER_AGENT=cartia-legal/0.1 (scraper de normas oficiales)
# CATALOG_DIR=./documents/_catalogo
