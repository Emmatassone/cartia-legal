# Connection string de Neon (Postgres + pgvector).
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

GOOGLE_API_KEY=

# Modelos por rol. El guardrail usa el modelo mas rapido porque corre en cada turno.
GEMINI_GUARDRAIL_MODEL=gemini-2.5-flash-lite
GEMINI_REWRITE_MODEL=gemini-2.5-flash
GEMINI_ANSWER_MODEL=gemini-2.5-pro
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

RAG_SERVICE_URL=http://localhost:8002
INTERNAL_TOKEN=change-me-shared-with-rag
# Solo true cuando el backend corre en Cloud Run y el servicio RAG es privado.
RAG_USE_ID_TOKEN=false

RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_ATTEMPTS=2
SEMANTIC_WEIGHT=0.6
# true = el retrieval no trae normas marcadas como derogadas (salvo pedido explicito).
RETRIEVAL_EXCLUIR_DEROGADAS=true

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
DEBUG=false

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cartia-legal
