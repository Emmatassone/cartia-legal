# Configuración del entorno local que levanta el Tiltfile.
# Copiar a `.env` y completar GOOGLE_API_KEY. El resto tiene defaults usables en desarrollo.
#
#   cp .env.example .env

# API key de Google AI Studio (https://aistudio.google.com/apikey).
# Es la única obligatoria: se usa para embeddings, guardrail, reescritura y generación.
GOOGLE_API_KEY=

# Password del Postgres local. Solo aplica al contenedor que levanta Tilt.
POSTGRES_PASSWORD=cartia-local

# Secreto de firma de los JWT del backend.
JWT_SECRET=jwt-secret-solo-para-desarrollo-local-0123456789

# Token compartido entre backend, rag y rag-loader para las llamadas internas.
INTERNAL_TOKEN=token-interno-local

# Dimensionalidad de los embeddings. Tiene que coincidir en rag y rag-loader: cambiarla
# obliga a un reindex completo, porque los vectores viejos dejan de ser comparables.
# HNSW en pgvector soporta hasta 2000 dimensiones.
EMBEDDING_DIMENSIONS=1536
