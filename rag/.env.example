# Connection string de Neon (Postgres + pgvector).
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Cuantos candidatos trae cada rama (vectorial y lexica) antes de fusionar con RRF.
CANDIDATE_POOL=40
# Constante k de Reciprocal Rank Fusion. Valores altos achatan la diferencia entre ranks.
RRF_K=60
INTERNAL_TOKEN=change-me-shared-with-backend
LOG_LEVEL=INFO
